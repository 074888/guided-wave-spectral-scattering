
M_all_Res = {};
S_all_Res  ={};
count  =0;
N=80;
% F_Lo=0.1e6:0.005e6:0.25e+06;
F_Lo=0.1e6:0.04e6:0.9e6;
Mode_In=1;
for F0=F_Lo

    Tube_Tube_Single_Scaterr

    count=count+1;
    M_all=Fin_Scatter(1:length(Ki_Fp_M),Mode_In);

    S_all=Fin_Scatter(length(Ki_Fp_M)+2:length(Ki_Fp_S)+length(Ki_Fp_M)+1,Mode_In);

    M_all_Res{count}=M_all;
    S_all_Res{count}=S_all;




    clearvars -except S_all_Res M_all_Res F0 N Mode_In  count F_Lo
end

%% --------------------

M_1=[];M_2=[];M_3=[];M_4=[];M_5=[];
for lo=1:length(M_all_Res)
    if length(M_all_Res{lo})<=2
        M_1 = [M_1 M_all_Res{lo}(1)];
        M_2 = [M_2 M_all_Res{lo}(2)];
        M_3 = [0 M_3];
        M_4 = [0 M_4];
        M_5 = [0 M_5];
    elseif length(M_all_Res{lo})<=3
        M_1 = [M_1 M_all_Res{lo}(1)];
        M_2 = [M_2 M_all_Res{lo}(2)];
        M_3 = [M_3 M_all_Res{lo}(3)];
        M_4 = [0 M_4];
        M_5 = [0 M_5];

    elseif length(M_all_Res{lo})<=4
        M_1 = [M_1 M_all_Res{lo}(1)];
        M_2 = [M_2 M_all_Res{lo}(2)];
        M_3 = [M_3 M_all_Res{lo}(3)];
        M_4 = [M_4 M_all_Res{lo}(4)];
        M_5 = [0 M_5];
    else
        M_1 = [M_1 M_all_Res{lo}(1)];
        M_2 = [M_2 M_all_Res{lo}(2)];
        M_3 = [M_3 M_all_Res{lo}(3)];
        M_4 = [M_4 M_all_Res{lo}(4)];
        M_5 = [M_5 M_all_Res{lo}(5)];
    end
end

S_1=[];S_2=[];S_3=[];
for lo=1:length(S_all_Res)
    if length(S_all_Res{lo})<=2
        S_1 = [S_1 S_all_Res{lo}(1)];
        S_2 = [S_2 S_all_Res{lo}(2)];
        S_3 = [0 S_3];
    elseif length(S_all_Res{lo})<=3
        S_1 = [S_1 S_all_Res{lo}(1)];
        S_2 = [S_2 S_all_Res{lo}(2)];
        S_3 = [S_3 S_all_Res{lo}(3)];
    else
        S_1 = [S_1 S_all_Res{lo}(1)];
        S_2 = [S_2 S_all_Res{lo}(2)];
        S_3 = [S_3 S_all_Res{lo}(3)];
        S_4 = [S_4 S_all_Res{lo}(4)];
    end
end



figure(1)
YourLine=3;
plot(F_Lo,M_1,":k",LineWidth=YourLine,Color=[0.9290 0.6940 0.1250]);hold on
plot(F_Lo,M_2,":r",LineWidth=YourLine,Color=[0.4940 0.1840 0.5560]);hold on
plot(F_Lo,M_3,":b",LineWidth=YourLine,Color=[0.4660 0.6740 0.1880]);hold on
plot(F_Lo,M_4,":g",LineWidth=YourLine,Color=[0.6350 0.0780 0.1840]);hold on
plot(F_Lo,M_5,":g",LineWidth=YourLine,Color=[0.8500 0.3250 0.0980]);hold on

plot(F_Lo,S_1,"-.y",LineWidth=YourLine);hold on
plot(F_Lo,S_2,"-.m",LineWidth=YourLine);hold on
plot(F_Lo,S_3,"-.b",Color=[0.4940 0.1840 0.5560],LineWidth=YourLine);hold on
legend("Ref1","Ref2","Ref3","Ref4","Ref5","Tra1","Tra2","Tra3");hold on
xlim([F_Lo(1) F_Lo(end)]) 
ylim([0 1])
grid on

xlabel("Frequency",FontSize=15);
ylabel("Scattering coefficients",FontSize=15);

%% half Analyze

F_Lo=0.1e6:0.04e6:0.9e6;

for f=F_Lo

        
    circumstep
    
    figure(1)
    plot(f,scat(:,1),"or",MarkerSize=15);
    hold on 
    grid on
end

